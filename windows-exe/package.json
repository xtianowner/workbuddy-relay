{
  "name": "workbuddy-relay-windows-exe",
  "private": true,
  "description": "Optional build: bundle wb-setup into single Windows / macOS executables",
  "scripts": {
    "prebundle": "node ../configure-build.mjs && node ../workbuddy/lib/build-page.mjs",
    "bundle": "esbuild entry.mjs --bundle --platform=node --target=node20 --format=cjs --minify --legal-comments=none --outfile=out/wb.cjs",
    "build": "npm run bundle && pkg out/wb.cjs -t node20-win-x64 -C GZip -o out/WorkBuddy-Relay-Import.exe",
    "build:sea": "powershell -NoProfile -ExecutionPolicy Bypass -File build-sea.ps1",
    "build:all": "bash ../build-release.sh"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.14.2",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  }
}
