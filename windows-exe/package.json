{
  "name": "workbuddy-relay-windows-exe",
  "private": true,
  "description": "Optional build: bundle wb-setup into single Windows / macOS executables",
  "scripts": {
    "prebundle": "node ../configure-build.mjs && node ../workbuddy/lib/build-page.mjs",
    "bundle": "node bundle.mjs",
    "build": "node build-native.mjs",
    "build:sea": "powershell -NoProfile -ExecutionPolicy Bypass -File build-sea.ps1",
    "build:all": "bash ../build-release.sh"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
